.fc-screen-login {
    width: 375px;
    height: 812px;
    overflow: hidden;
    background-color: var(--color-surface);
    flex-direction: column;
    row-gap: var(--space-gutter);
    justify-content: flex-start;
    align-items: flex-start;
    padding: 24px;
}

.fc-title {
    color: var(--color-text);
}

.fc-subtitle {
    font-size: 14px;
    -unity-text-align: upper-left;
    color: #666666;
}

.fc-button-primary {
    width: 327px;
    height: 48px;
    overflow: hidden;
    border-radius: 12px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    font-size: 16px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.fc-input-default {
    width: 327px;
    height: 56px;
    overflow: hidden;
    background-color: #F2F2F2;
    border-radius: 10px;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    padding: 12px;
    font-size: 16px;
    color: #888888;
}

.fc-card-promo-wrap {
    width: 327px;
    height: 170px;
}

.fc-card-promo-shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: linear-gradient(117.469deg, #FF0066 0%, #6600FF 100%);
    border-radius: var(--radius-card);
}

.fc-card-promo {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
    flex-direction: column;
    row-gap: 8px;
    justify-content: flex-start;
    align-items: flex-start;
    padding: 16px;
}

.fc-cardtitle {
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: upper-left;
    color: #FFFFFF;
}

.fc-grid-stats {
    width: 327px;
    height: 120px;
    overflow: hidden;
    background-color: #FFFFFF;
    flex-direction: row;
    flex-wrap: wrap;
    column-gap: 8px;
    row-gap: 8px;
    justify-content: flex-start;
    align-items: flex-start;
}

.fc-stat-a {
    width: 103px;
    height: 120px;
    background-color: #EEF2FF;
    border-radius: 8px;
}

.fc-stat-b {
    width: 103px;
    height: 120px;
    background-color: #EEF2FF;
    border-radius: 8px;
}

.fc-outlined-wrap {
    width: 141px;
    height: 39px;
    position: relative;
}

.fc-outlined-shadow {
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: upper-left;
    color: rgba(0, 0, 0, 0.4);
    -unity-text-outline-color: rgba(0, 0, 0, 0.4);
    -unity-text-outline-width: 6px;
    position: absolute;
    left: 2px;
    top: 4px;
}

.fc-outlined-text {
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: upper-left;
    color: #FFFFFF;
    -unity-text-outline-color: #111111;
    -unity-text-outline-width: 6px;
    position: absolute;
    left: 0;
    top: 0;
}

.fc-icon-star {
    width: 20px;
    height: 19px;
    background-image: url("baked/icon-star.svg");
    -unity-background-scale-mode: scale-to-fit;
}

.fc-card-angular {
    width: 327px;
    height: 96px;
    overflow: hidden;
    background-image: url("baked/card-angular-fill.png");
    -unity-background-scale-mode: scale-and-crop;
    border-radius: 16px;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    padding: 16px;
}

.fc-angularlabel {
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: upper-left;
    color: #FFFFFF;
}

.fc-divider-dashed {
    width: 327px;
    height: 2px;
    background-image: url("baked/divider-dashed-stroke.svg");
    -unity-background-scale-mode: scale-to-fit;
}

