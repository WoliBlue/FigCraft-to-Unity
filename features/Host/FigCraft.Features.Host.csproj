<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>figcraft-unity-features</AssemblyName>
    <RootNamespace>FigCraft.Features.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\Shared\FigCraft.Features.csproj" />

    <!-- Every folder next to Host that is not Host, Shared or the tests is a feature project.
         Adding a feature means adding a folder; nothing here has to change. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\*\*.csproj"
                      Exclude="$(MSBuildThisFileDirectory)..\Host\*.csproj;$(MSBuildThisFileDirectory)..\Shared\*.csproj;$(MSBuildThisFileDirectory)..\tests\**\*.csproj" />
  </ItemGroup>

</Project>
